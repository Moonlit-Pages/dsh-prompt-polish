{
  "name": "dsh-prompt-polish",
  "version": "0.2.0",
  "description": "Prompt polish button beside the composer model selector: rewrite the draft, then undo the rewrite.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-engineering",
    "composer"
  ],
  "engines": {
    "node": ">=20.11",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/optimizer.test.mjs test/routes.test.mjs test/client.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "prepack": "node scripts/preflight.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
